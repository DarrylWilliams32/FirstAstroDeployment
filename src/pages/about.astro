---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "About Me";

const identity = {
  firstName: "Darryl",
  country: "United States",
  occupation: "Software Engineer",
  hobbies: ["guitar", "fitness", "game development", "gaming", "coding", "reading"],
};

const currentYear = new Date().getFullYear();
const yearStarted = 2021;
const skills = ["HTML", "CSS", "JavaScript", "Java", "PostgreSQL", "MongoDB", "React", "Astro", "Writing Docs"];

//Will import this as reusable variable in CSS
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "Arial";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} >
        <title>{pageTitle}</title>
        <!--imports JS variable as a CSS class -->
        <style define:vars={{skillColor, fontWeight, textCase}}>
      h1 {
        color: purple;
        font-size: 4rem;
      }
      .skill {
    color: var(--skillColor);
    font-weight: var(--fontWeight);
    text-transform: var(--textCase);
    }
    </style>
    </head>
    <body>
        <BaseLayout pageTitle={pageTitle}>
        
        <h2>The journey and the destination</h2>

        <p>My name is {identity.firstName}. I've been a Software Engineer for {currentYear - yearStarted} years. I've built both SQL and cloud based databases, web applications, websites, and games. I have a passion for solving complex problems and getting out of my comfort zone.</p>

<p>My skills are:</p>
<ul>
  {skills.map((skill) => <li class="skill">{skill}</li>)}
</ul>

</BaseLayout>
    </body>

  <script>
    import "../scripts/menu";
  </script>
</html>