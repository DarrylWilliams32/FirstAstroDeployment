---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const {pageTitle} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<Header />
    	<h1>{pageTitle}</h1>
		<slot/>

		<button class="book-call-btn" id="openModalBtn">
    Book a call
  		</button>
		<!-- Modal Structure -->
		<div class="modal-overlay" id="bookingModal" aria-hidden="true" role="dialog">
    		<div class="modal-container">
      			<button class="modal-close-btn" id="closeModalBtn" aria-label="Close modal">&times;</button>
      
				<!-- TidyCal Embed Widget -->
				<div class="tidycal-embed" data-path="darrylwilliams6/30-minute-meeting"></div>
      		</div>
  		</div>
		<!-- TidyCal Script -->
  		<script src="https://asset-tidycal.b-cdn.net/js/embed.js" async></script>
		</body>
    	<Footer />

		<script>
			import '../scripts/menu.js';
			import '../scripts/scheduleModal.js';
		</script>
</html>

